DJANGO_SECRET_KEY=replace-with-a-real-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,matty-dev.com,www.matty-dev.com

# Use "resend" on hosts where outbound SMTP is blocked.
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
RESEND_API_URL=https://api.resend.com/emails

# SMTP fallback for environments where outbound SMTP is available.
# EMAIL_PROVIDER=smtp
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=hello@example.com
# EMAIL_HOST_PASSWORD=replace-with-smtp-app-password
# EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Matty Dev <hello@example.com>
PROJECT_ENQUIRY_NOTIFICATION_EMAIL=hello@example.com
